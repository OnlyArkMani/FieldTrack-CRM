# SamarthSathi staging environment — copy to .env.staging and fill in real values.
# NEVER commit .env.staging. Generate secrets with:  openssl rand -hex 32

# ── App ──────────────────────────────────────────────────────────
APP_ENV=staging                    # keeps Swagger docs + OpenAPI JSON accessible
APP_NAME=SamarthSathi
DEBUG=false                        # false even in staging — no stack traces to clients
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=http://staging.your-domain.com
# Comma-separated. Set to the staging server's domain/IP.

# ── Database (Postgres 15 + PostGIS) ────────────────────────────
POSTGRES_USER=fieldtrack
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=fieldtrack_staging
# Provided by DevOps — points to the staging Postgres instance.
DATABASE_URL=postgresql+asyncpg://fieldtrack:CHANGE_ME_strong_password@127.0.0.1:5433/fieldtrack_staging
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# ── Redis ────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_URL=redis://:CHANGE_ME_redis_password@127.0.0.1:6380/0

# ── JWT ──────────────────────────────────────────────────────────
# Two DIFFERENT secrets so a leaked access-token key can't mint refresh tokens.
# Use different values from production — staging tokens must not work on prod.
JWT_ACCESS_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_REFRESH_SECRET=CHANGE_ME_openssl_rand_hex_32_different
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Firebase Cloud Messaging ─────────────────────────────────────
# Use a separate staging Firebase project to avoid polluting prod devices.
FCM_SERVICE_ACCOUNT_FILE=/run/secrets/fcm-service-account.json
# Alternatively, supply the base64-encoded content of the service-account JSON directly:
FCM_SERVICE_ACCOUNT_B64=
FCM_PROJECT_ID=your-firebase-staging-project-id

# ── Rate limiting ────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=120

# ── Object storage (MinIO / S3-compatible) ───────────────────────
MINIO_BUCKET=fieldtrack-staging-storage
MINIO_REGION=us-east-1
MINIO_ENDPOINT_URL=http://minio:9000   # docker-internal hostname
# Presigned URLs are fetched directly by browser/mobile — must be reachable
# from outside Docker. Set to the staging server's public host:port.
MINIO_PUBLIC_ENDPOINT_URL=http://staging.your-domain.com:9000
MINIO_ACCESS_KEY_ID=CHANGE_ME_minio_user
MINIO_SECRET_ACCESS_KEY=CHANGE_ME_minio_password_min_8_chars
MINIO_USE_PATH_STYLE=true

# ── Reports (CSV/Excel/PDF exports) ──────────────────────────────
REPORT_MINIO_PREFIX=reports
REPORT_RETENTION_MINUTES=60
REPORT_DOWNLOAD_URL_TTL_SECONDS=300

# ── Visit photos ─────────────────────────────────────────────────
VISIT_PHOTO_MINIO_PREFIX=visit_photos
MAX_VISIT_PHOTOS=5
MAX_VISIT_PHOTO_BYTES=8388608       # 8 MB per photo
VISIT_PHOTO_DOWNLOAD_URL_TTL_SECONDS=300

# ── OpenTelemetry tracing ────────────────────────────────────────
# DevOps provides the collector endpoint.
OTEL_ENABLED=false
OTEL_ENDPOINT=                     # e.g. http://otel-collector:4317
OTEL_SERVICE_NAME=samarth-sathi-api-staging

# ── App server ───────────────────────────────────────────────────
GUNICORN_WORKERS=2                 # staging runs on a smaller box than prod
