# FieldTrack environment — copy to .env and fill in real values.
# NEVER commit .env. Generate secrets with:  openssl rand -hex 32

# ── App ──────────────────────────────────────────────────────────
APP_ENV=development                # development | staging | production
APP_NAME=FieldTrack
DEBUG=true                         # MUST be false in production
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Comma-separated. Add the admin dashboard's real origin in production.

# ── Database (Postgres 15 + PostGIS) ────────────────────────────
POSTGRES_USER=fieldtrack
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=fieldtrack
POSTGRES_HOST_PORT=5433            # host-side port; 5433 avoids your existing dockerized PG
# Used by the app INSIDE compose (overridden in docker-compose.yml).
# For running alembic/app from the host, point at 127.0.0.1:5433:
DATABASE_URL=postgresql+asyncpg://fieldtrack:CHANGE_ME_strong_password@127.0.0.1:5433/fieldtrack
DB_POOL_SIZE=10                    # raise to ~20 at 100 employees; nothing else changes
DB_MAX_OVERFLOW=5

# ── Redis ────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_HOST_PORT=6380
REDIS_URL=redis://:CHANGE_ME_redis_password@127.0.0.1:6380/0

# ── JWT ──────────────────────────────────────────────────────────
# Two DIFFERENT secrets so a leaked access-token key can't mint refresh tokens.
JWT_ACCESS_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_REFRESH_SECRET=CHANGE_ME_openssl_rand_hex_32_different
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Firebase Cloud Messaging ─────────────────────────────────────
# Path to the service-account JSON (FCM HTTP v1 API — legacy server keys are deprecated).
FCM_SERVICE_ACCOUNT_FILE=/run/secrets/fcm-service-account.json
# Alternatively, supply the base64-encoded content of the service-account JSON directly:
FCM_SERVICE_ACCOUNT_B64=
FCM_PROJECT_ID=your-firebase-project-id

# ── Nginx ────────────────────────────────────────────────────────
NGINX_HTTP_PORT=8090               # 8080/8081 unavailable on this machine

# ── Rate limiting ────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=120          # default per-user per-endpoint window

# ── Object storage (self-hosted MinIO) ────────────────────────────
# Backs both report exports and visit photos. docker-compose-dev.yml runs a
# `minio` service on the same network — MINIO_ACCESS_KEY_ID/SECRET below double
# as its MINIO_ROOT_USER/MINIO_ROOT_PASSWORD (one pair, no drift). The bucket
# is created automatically at app startup if missing (CORS is NOT — MinIO
# doesn't support bucket-level CORS via the S3 API at all, confirmed live;
# CORS headers are added by whatever proxies MinIO's published port instead).
# Still works against real AWS S3/Backblaze B2/DigitalOcean Spaces instead —
# just point MINIO_ENDPOINT_URL there and set MINIO_USE_PATH_STYLE=false for AWS.
MINIO_BUCKET=fieldtrack-storage
MINIO_REGION=us-east-1
MINIO_ENDPOINT_URL=http://minio:9000   # docker-internal — this backend's OWN upload/download traffic only
# TWO ENDPOINTS ON PURPOSE (confirmed via live testing — not a hypothetical):
# presigned download URLs are fetched directly by the browser/mobile app, NOT
# by this backend container, so they can't be signed against the
# docker-internal hostname above (it won't even resolve outside the Docker
# network — the download fails to connect, not just "looks wrong"). Set this
# to whatever host/port THEY can actually reach — e.g. `http://localhost:9000`
# for local dev (MinIO's port is published), or a real domain in production
# (see docker-compose.prod.yml / nginx.prod.conf's dedicated-port-9000
# pattern, which also adds the CORS headers MinIO itself can't).
MINIO_PUBLIC_ENDPOINT_URL=http://localhost:9000
MINIO_ACCESS_KEY_ID=CHANGE_ME_minio_user
MINIO_SECRET_ACCESS_KEY=CHANGE_ME_minio_password_min_8_chars
MINIO_USE_PATH_STYLE=true              # MinIO needs path-style; false for real AWS

# ── Reports (CSV/Excel/PDF exports) ──────────────────────────────
# Rendered files go to S3 under this key prefix. Files + their Redis status
# expire after REPORT_RETENTION_MINUTES. Download links are short-lived
# presigned S3 URLs (REPORT_DOWNLOAD_URL_TTL_SECONDS).
REPORT_MINIO_PREFIX=reports
REPORT_RETENTION_MINUTES=60
REPORT_DOWNLOAD_URL_TTL_SECONDS=300

# ── Visit photos (checklist #24) ─────────────────────────────────
# Image bytes for visit attachments (up to MAX_VISIT_PHOTOS per visit) go to
# S3 under this key prefix. Permanent — not pruned like reports.
VISIT_PHOTO_MINIO_PREFIX=visit_photos
MAX_VISIT_PHOTOS=5
MAX_VISIT_PHOTO_BYTES=8388608       # 8 MB per photo
VISIT_PHOTO_DOWNLOAD_URL_TTL_SECONDS=300

# ── App server ───────────────────────────────────────────────────
UVICORN_WORKERS=2                  # = vCPU count; raise with bigger VPS
