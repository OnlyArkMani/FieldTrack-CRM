# SamarthSathi — PRODUCTION environment template.
# Copy to `.env.prod` on the VPS (NOT in git), fill in real values.
# Generate secrets with:  openssl rand -hex 32

# ── App ──────────────────────────────────────────────────────────
APP_ENV=production
APP_NAME=SamarthSathi
DEBUG=false                        # MUST be false — disables /docs and /openapi.json
API_V1_PREFIX=/api/v1
# Comma-separated. Must match the domain(s) the admin SPA is served from.
ALLOWED_ORIGINS=https://your-domain.com

# ── Database (Postgres 15 + PostGIS) ────────────────────────────
POSTGRES_USER=fieldtrack
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=fieldtrack
# DATABASE_URL is built by docker-compose.prod.yml from the three vars above;
# you don't need to set it here for the app container. Only set it if you run
# alembic from the host (not recommended in prod — use `docker compose exec app`).
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ── Redis ────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_redis_password
# REDIS_URL is built by docker-compose.prod.yml from REDIS_PASSWORD.

# ── JWT ──────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_REFRESH_SECRET=CHANGE_ME_openssl_rand_hex_32_different
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Firebase Cloud Messaging ─────────────────────────────────────
FCM_SERVICE_ACCOUNT_FILE=/run/secrets/fcm-service-account.json
# Alternatively, supply the base64-encoded content of the service-account JSON directly:
FCM_SERVICE_ACCOUNT_B64=
FCM_PROJECT_ID=your-firebase-project-id

# ── Rate limiting ────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=120

# ── Object storage (self-hosted MinIO, docker-compose.prod.yml) ──
# MINIO_ACCESS_KEY_ID/SECRET double as MinIO's own root credentials — one pair,
# no drift. TWO different endpoints, on purpose (confirmed via live testing):
# MINIO_ENDPOINT_URL is docker-internal, for this backend's OWN traffic to MinIO
# over fieldtrack_network. MINIO_PUBLIC_ENDPOINT_URL is what actually gets signed
# into presigned download URLs — those are fetched directly by browsers/
# phones, which cannot resolve `minio:9000` at all (the download fails to
# connect, not just "looks wrong"). nginx.prod.conf publishes MinIO's S3 API
# on a dedicated port 9000 using this same domain's TLS cert (it also adds the
# CORS headers MinIO itself can't — confirmed live, a real platform
# limitation, not a config issue). Open port 9000 in any external
# firewall/security group.
MINIO_BUCKET=fieldtrack-storage
MINIO_REGION=us-east-1
MINIO_ENDPOINT_URL=http://minio:9000
MINIO_PUBLIC_ENDPOINT_URL=https://your-domain.com:9000
MINIO_ACCESS_KEY_ID=CHANGE_ME_minio_user
MINIO_SECRET_ACCESS_KEY=CHANGE_ME_minio_password_min_8_chars
MINIO_USE_PATH_STYLE=true

# ── Reports (CSV/Excel/PDF exports) ──────────────────────────────
REPORT_MINIO_PREFIX=reports
REPORT_RETENTION_MINUTES=60
REPORT_DOWNLOAD_URL_TTL_SECONDS=300

# ── Visit photos (checklist #24) ─────────────────────────────────
VISIT_PHOTO_MINIO_PREFIX=visit_photos
MAX_VISIT_PHOTOS=5
MAX_VISIT_PHOTO_BYTES=8388608
VISIT_PHOTO_DOWNLOAD_URL_TTL_SECONDS=300

# ── App server ───────────────────────────────────────────────────
# Number of Gunicorn workers (docker-compose.prod.yml command). 4 is the
# default for a 2 vCPU VPS — change here, nothing else, to scale up.
GUNICORN_WORKERS=4

# ── Monitoring (monitoring/docker-compose.monitoring.yml) ────────
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_admin_password

# ── Image tag ────────────────────────────────────────────────────
# Which built image the `app` service runs. The deploy workflow sets this to
# the commit SHA; locally it defaults to "latest".
IMAGE_TAG=latest
